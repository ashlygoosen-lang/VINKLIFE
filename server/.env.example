# ── Required in production ─────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=                 # Railway: reference ${{Postgres.DATABASE_URL}}
SESSION_SECRET=               # 32+ random chars:  openssl rand -hex 32
ADMIN_PASSWORD=               # 12+ chars; signs you in at /admin
ALLOWED_ORIGINS=https://your-site.up.railway.app   # comma-separated site origins (CORS)
PUBLIC_API_URL=https://your-api.up.railway.app     # used in unsubscribe links
SITE_URL=https://your-site.up.railway.app

# ── Email (optional but recommended) — https://resend.com ──────────
RESEND_API_KEY=
MAIL_FROM=VINK Group <noreply@yourdomain.com>      # domain must be verified in Resend
NOTIFY_EMAIL=hello@vinkgroup.com
PARTNERS_EMAIL=partners@vinkgroup.com
INVEST_EMAIL=invest@vinkgroup.com
CAREERS_EMAIL=careers@vinkgroup.com

# ── Optional ───────────────────────────────────────────────────────
# PORT=8787            (Railway sets this for you)
# PGSSL=require        (only if connecting to Postgres over its public proxy URL)
# SESSION_HOURS=12
